# Required for the default Anthropic provider
ANTHROPIC_API_KEY=your_api_key_here

# Optional: For OpenAI provider
# OPENAI_API_KEY=your_api_key_here

# Optional: For other providers
# OPENROUTER_API_KEY=your_api_key_here
# DEEPSEEK_API_KEY=your_api_key_here
# GEMINI_API_KEY=your_api_key_here
# OPENAI_API_BASE=your_api_base_url

# Expert Tool Environment Variables (optional)
# EXPERT_OPENAI_API_KEY=your_api_key_here
# EXPERT_ANTHROPIC_API_KEY=your_api_key_here
# EXPERT_OPENROUTER_API_KEY=your_api_key_here
# EXPERT_OPENAI_API_BASE=your_api_base_url
# EXPERT_GEMINI_API_KEY=your_api_key_here
# EXPERT_DEEPSEEK_API_KEY=your_api_key_here
